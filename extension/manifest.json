{
  "manifest_version": 3,
  "name": "Metacheck reports for PsyArXiv",
  "version": "0.1.0",
  "description": "On a PsyArXiv preprint page, adds a button that opens Metacheck's report on that preprint, when there is one.",
  "homepage_url": "https://lakens.github.io/psyarxiv-reproducibility/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://osf.io/*", "https://next.psyarxiv.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "metacheck-psyarxiv@lakens.github.io",
      "strict_min_version": "109.0"
    }
  }
}
